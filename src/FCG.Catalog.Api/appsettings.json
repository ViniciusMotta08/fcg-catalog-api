{
  "ConnectionStrings": {
    "CatalogDb": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "FCG.UsersApi",
    "Audience": "FCG.Clientes"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Porta": 5672,
    "Usuario": "",
    "Senha": "",
    "VirtualHost": "/",
    "Exchange": "fcg.events",
    "DeadLetterExchange": "fcg.events.dlx",
    "PrefetchCount": 10,
    "Filas": {
      "PaymentProcessed": "catalog.payment-processed"
    }
  },
  "Banco": {
    "CriarEstruturaAutomaticamente": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}